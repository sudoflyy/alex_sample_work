/**
 * Create advanced queue index on the payload field.
 */
function ipc_syncdb_update_9407() {
  $module_handler = \Drupal::moduleHandler();
  $module_handler->loadInclude('advancedqueue', 'install', 'advancedqueue');
  $spec = advancedqueue_schema();
  $schema = Database::getConnection()->schema();
  if (!$schema->indexExists('advancedqueue', 'payload')) {
    $schema->addIndex('advancedqueue', 'payload', [
      [
        'payload',
        128,
      ],
    ], $spec['advancedqueue']);
  }
}

/**
 * Update orders.
 */
function ipc_syncdb_update_9409(&$sandbox) {
  $count = \Drupal::database()
    ->update('commerce_order')
    ->expression('order_number', 'CONCAT(:prefix, order_number)', [':prefix' => 'CF-'])
    ->condition('type', ['default', 'quote_purchase'] , 'IN')
    ->isNotNull('order_number')
    ->condition('order_number', 'CF-%', 'NOT LIKE')
    ->execute();

    drupal_flush_all_caches();
}

/**
 * Update quotes.
 */
function ipc_syncdb_update_9410(&$sandbox) {
  $count = \Drupal::database()
    ->update('commerce_invoice_field_data')
    ->expression('invoice_number', 'CONCAT(:prefix, invoice_number)', [':prefix' => 'QT-'])
    ->condition('type', 'quote')
    ->isNotNull('invoice_number')
    ->condition('invoice_number', 'QT-%', 'NOT LIKE')
    ->execute();

    drupal_flush_all_caches();

}

/**
 * Update files with additional space.
 */
function ipc_syncdb_update_9411(&$sandbox) {
  $count = \Drupal::database()
    ->update('file_managed')
    ->fields([
      'filename' => 'IPC-7351B-German_DRM.zip',
    ])
    ->condition('fid', 3491)
    ->execute();

  $count = \Drupal::database()
    ->update('file_managed')
    ->fields([
      'filename' => 'IPC-1752A-Am-3-Schema.xsd',
    ])
    ->condition('fid', 1409)
    ->execute();

    drupal_flush_all_caches();

}
